    screen_rect = Rect(0, 0, 1920, 1080)
    window_rect = Rect(100, 50, 1720, 980)

    buffer   = ScreenBuffer(1920, 1080)
    reader   = ScreenReader(mode=ScanMode.NORMAL)
    regions  = reader.scan(buffer)

    analyzer = LayoutAnalyzer(screen_rect)
    report   = analyzer.generate_report(regions)

    mapper   = CoordinateMapper(screen_rect, window_rect, dpi_scale=1.5)
    origin   = Point(screen_rect.cx, screen_rect.cy)

    btn = reader.find_element(ElementRole.BUTTON, hint="submit")
    if btn:
        win_pos = mapper.region_in_window(btn)
        rel_pos = btn.relative_to(origin)
